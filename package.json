{
  "name": "dsh-server-connector",
  "version": "0.1.0",
  "description": "DSH plugin: SSH execution for servers configured on this machine, with a built-in high-risk command policy (block / confirm / allow).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./policy": "./lib/policy.js",
    "./registry": "./lib/registry.js",
    "./audit": "./lib/audit.js",
    "./known-hosts": "./lib/known-hosts.js",
    "./pool": "./lib/pool.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "icon": "./icon.svg",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.0-rc.6 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:policy": "node --test tests/policy.test.ts",
    "test:registry": "node --test tests/registry.test.ts",
    "test:audit": "node --test tests/audit.test.ts",
    "test:known-hosts": "node --test tests/known-hosts.test.ts",
    "test:pool": "node --test tests/pool.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "ssh2": "^1.17.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-user-approval": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-jobs": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-credentials": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    },
    "@deepseek-ai/dsh-jobs": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.0",
    "@types/ssh2": "^1.15.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "ssh",
    "deepseek-harness"
  ],
  "license": "MIT"
}
