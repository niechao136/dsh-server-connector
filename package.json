{
  "name": "dsh-server-connector",
  "version": "0.1.0",
  "description": "DSH plugin: SSH execution for servers configured on this machine, with a built-in high-risk command policy (block / confirm / allow).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./policy": "./lib/policy.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.0-rc.6 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:policy": "node --test tests/policy.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-user-approval": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-jobs": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-credentials": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    },
    "@deepseek-ai/dsh-jobs": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "ssh",
    "deepseek-harness"
  ],
  "license": "MIT"
}
